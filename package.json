{
  "name": "faraway-test-task",
  "version": "0.1.0",
  "homepage": "https://dmitrytevtonsky.github.io/faraway-test-task",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@reduxjs/toolkit": "^2.13.0",
    "antd": "^6.6.6",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "scripts": {
    "start": "webpack serve --mode=development",
    "build": "npm run typecheck && webpack --mode=production",
    "analyze": "npm build --env analyze",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "eslint": "pnpm lint:fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "deploy": "npm run build && gh-pages -d dist",
    "cy": "cypress open",
    "cy:run": "cypress run"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cypress": "^16.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.112.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}